  "checklist": [],
  "code": "// Tablets are dedusted, counted and sorted\nDeduster_Run := Compressing;\nGate_Reject := Reject_All OR Metal_Detected OR Weight_Out_Of_Spec;\n\nRejectEdge(CLK := Gate_Reject AND TabletPresent);\nIF RejectEdge.Q THEN\n    RejectCount := RejectCount + 1;\nEND_IF;\n\n// the reject gate must follow the request within the timeout\nGateFault := Gate_Reject AND NOT Gate_InReject AND GateTimer.Q;",

  "checklist": [],
  "code": "// Feeder speed follows the hopper level and the fill demand\nFeedingReady := NOT Hopper_Empty AND NOT Feeder_Fault;\n\nIF FeedingReady AND Compressing THEN\n    Feeder_SP_rpm := LIMIT(20.0, Fill_Demand_pct * 1.2, 120.0);\nELSE\n    Feeder_SP_rpm := 0.0;\nEND_IF;\n\nRefill_Request := Hopper_Low;",
  "currentVersion": "1.1",
  "description": "Keeps the dies filled: feeder speed follows the hopper level and the fill demand.",

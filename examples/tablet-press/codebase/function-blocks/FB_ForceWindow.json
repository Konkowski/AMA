  "alarms": [],
  "category": "Logic",
  "code": "FUNCTION_BLOCK FB_ForceWindow\nVAR_INPUT\n    Force_kN : REAL;\n    Target_kN : REAL;\n    Tol_pct : REAL := 10.0;\nEND_VAR\nVAR_OUTPUT\n    InWindow : BOOL;\n    TooHigh : BOOL;\n    TooLow : BOOL;\nEND_VAR\nVAR\n    Band : REAL;\nEND_VAR\n\nBand := Target_kN * Tol_pct / 100.0;\nTooHigh := Force_kN > (Target_kN + Band);\nTooLow := Force_kN < (Target_kN - Band);\nInWindow := NOT TooHigh AND NOT TooLow;\nEND_FUNCTION_BLOCK",
  "currentVersion": "1.1",
  "description": "Checks a measured compression force against a target and a tolerance band (percent).",

  "category": "Logic",
  "code": "FUNCTION_BLOCK FB_Debounce\nVAR_INPUT\n    In : BOOL;\n    Time_ms : TIME := T#20ms;\nEND_VAR\nVAR_OUTPUT\n    Out : BOOL;\nEND_VAR\nVAR\n    Timer : TON;\nEND_VAR\n\nTimer(IN := (In <> Out), PT := Time_ms);\nIF Timer.Q THEN\n    Out := In;\nEND_IF;\nEND_FUNCTION_BLOCK",
  "currentVersion": "1.1",
  "description": "Filters a digital input: the output follows the input only after it is stable for the set time.",

  "code": "IF Cmd_Run AND NOT Fault THEN\n    Out_Enable := TRUE;\n    Out_SpeedRef := LIMIT(0.0, Speed_SP_rpm, 120.0) / 120.0 * 100.0;\nELSE\n    Out_Enable := FALSE;\n    Out_SpeedRef := 0.0;\nEND_IF;\n\n// the drive must confirm running within 3 s\nFeedbackTimer(IN := Out_Enable AND NOT In_Running, PT := T#3s);\nFault := FeedbackTimer.Q;",

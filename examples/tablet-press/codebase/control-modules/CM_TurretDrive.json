  "checklist": [],
  "code": "Ramp(Target := Speed_SP_rpm, AccelPerS := 5.0, DecelPerS := 15.0);\nIF Cmd_Run AND NOT Fault THEN\n    Out_Enable := TRUE;\n    Out_SpeedRef := Ramp.Output;\nELSE\n    Out_Enable := FALSE;\n    Out_SpeedRef := 0.0;\nEND_IF;\n\n// the drive must confirm running within 5 s\nFeedbackTimer(IN := Out_Enable AND NOT In_Running, PT := T#5s);\nFault := FeedbackTimer.Q;",

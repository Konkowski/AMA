  "checklist": [],
  "code": "IF Cmd_Move AND In_Ready AND NOT Fault THEN\n    Out_Pos_SP := LIMIT(2.0, Pos_SP_mm, 20.0);\n    Out_Start := TRUE;\nELSE\n    Out_Start := FALSE;\nEND_IF;\n\nOutOfRange := (Pos_SP_mm < 2.0) OR (Pos_SP_mm > 20.0);\nFault := NOT In_Ready AND Out_Start;\n\n// slow weight correction from the average tablet weight\nWeightCtl(Enable := WeightCtl_On, AvgWeight_mg := AvgWeight_mg, Target_mg := Target_mg);\nOut_Pos_SP := LIMIT(2.0, Out_Pos_SP + WeightCtl.Correction_mm, 20.0);",
  "currentVersion": "1.1",

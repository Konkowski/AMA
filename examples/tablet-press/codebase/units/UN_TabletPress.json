  "category": "Logic",
  "checklist": [],
  "code": "// Machine states (PackML style): 0 Stopped, 1 Starting, 2 Execute, 3 Stopping, 4 Aborted\nCASE State OF\n    0: // stopped\n        IF Cmd_Start AND GuardsOK AND NOT Fault_Active THEN State := 1; END_IF;\n\n    1: // starting: let the drives and the feeder come up\n        Start_Press := TRUE;\n        StartTimer(IN := TRUE, PT := T#8s);\n        IF StartTimer.Q THEN State := 2; END_IF;\n        IF Fault_Active OR NOT GuardsOK THEN State := 4; END_IF;\n\n    2: // execute: producing tablets\n        StartTimer(IN := FALSE);\n        IF Cmd_Stop THEN State := 3; END_IF;\n        IF Fault_Active OR NOT GuardsOK THEN State := 4; END_IF;\n\n    3: // stopping: ramp down\n        Start_Press := FALSE;\n        IF Press_Stopped THEN State := 0; END_IF;\n\n    4: // aborted: needs a deliberate reset\n        Start_Press := FALSE;\n        IF Cmd_Reset AND GuardsOK AND NOT Fault_Active THEN State := 0; END_IF;\nEND_CASE;\n\nMode := State;",
  "currentVersion": "1.1",
  "description": "Rotary tablet press TP-200: feeds, compresses and sorts tablets under force control.",
  "devTimes": {
    "commissioningHours": 16,
    "hmiHours": 12,
    "plcHours": 24
  },
